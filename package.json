{
  "name": "@gravity-ui/uikit",
  "version": "8.0.0",
  "description": "Gravity UI base styling and components",
  "keywords": [
    "component",
    "design-system",
    "gravity-ui",
    "react",
    "react-component",
    "ui",
    "uikit",
    "web"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11",
    "yarn": "Please use npm instead of yarn to install dependencies",
    "pnpm": "Please use npm instead of pnpm to install dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/uikit"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./toaster-singleton": {
      "import": {
        "types": "./build/esm/toaster-singleton.d.ts",
        "default": "./build/esm/toaster-singleton.js"
      },
      "require": {
        "types": "./build/cjs/toaster-singleton.d.ts",
        "default": "./build/cjs/toaster-singleton.js"
      }
    },
    "./i18n": {
      "import": {
        "types": "./build/esm/i18n/index.d.ts",
        "default": "./build/esm/i18n/index.js"
      },
      "require": {
        "types": "./build/cjs/i18n/index.d.ts",
        "default": "./build/cjs/i18n/index.js"
      }
    },
    "./legacy": {
      "import": {
        "types": "./build/esm/legacy.d.ts",
        "default": "./build/esm/legacy.js"
      },
      "require": {
        "types": "./build/cjs/legacy.d.ts",
        "default": "./build/cjs/legacy.js"
      }
    },
    "./unstable": {
      "import": {
        "types": "./build/esm/unstable.d.ts",
        "default": "./build/esm/unstable.js"
      },
      "require": {
        "types": "./build/cjs/unstable.d.ts",
        "default": "./build/cjs/unstable.js"
      }
    },
    "./server": {
      "import": {
        "types": "./build/esm/server.d.ts",
        "default": "./build/esm/server.js"
      },
      "require": {
        "types": "./build/cjs/server.d.ts",
        "default": "./build/cjs/server.js"
      }
    },
    "./virtualizer": {
      "import": {
        "types": "./build/esm/virtualizer.d.ts",
        "default": "./build/esm/virtualizer.js"
      },
      "require": {
        "types": "./build/cjs/virtualizer.d.ts",
        "default": "./build/cjs/virtualizer.js"
      }
    },
    "./hello-pangea-dnd": {
      "import": {
        "types": "./build/esm/hello-pangea-dnd.d.ts",
        "default": "./build/esm/hello-pangea-dnd.js"
      },
      "require": {
        "types": "./build/cjs/hello-pangea-dnd.d.ts",
        "default": "./build/cjs/hello-pangea-dnd.js"
      }
    },
    "./styles/*": "./styles/*"
  },
  "main": "./build/cjs/index.js",
  "types": "./build/cjs/index.d.ts",
  "module": "./build/esm/index.js",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "build",
    "styles"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watchAll",
    "clean": "gulp clean",
    "build": "gulp",
    "generate:theme": "tsx scripts/generate-theme-scss.mjs",
    "start": "storybook dev -p 7007",
    "build-storybook": "storybook build -c .storybook -o storybook-static",
    "test-storybook": "test-storybook",
    "lint:js": "eslint",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:styles": "cross-env stylelint '{styles,src}/**/*.scss'",
    "lint:styles:fix": "cross-env npm run lint:styles -- --fix",
    "lint:prettier": "cross-env prettier --check '**/*.md'",
    "lint:prettier:fix": "cross-env prettier --write '**/*.md'",
    "lint": "run-p lint:*",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm pkg delete engines",
    "playwright:install": "playwright install chromium webkit --with-deps",
    "playwright": "playwright test --config=playwright/playwright.config.ts",
    "playwright:update": "npm run playwright -- -u all",
    "playwright:clear-cache": "rm -rf ./playwright/.cache",
    "playwright:docker": "./playwright/run-docker-command.sh npm run playwright --",
    "playwright:docker:update": "./playwright/run-docker-command.sh npm run playwright:update --",
    "playwright:docker:clear-cache": "./playwright/run-docker-command.sh clear-cache"
  },
  "dependencies": {
    "@bem-react/classname": "^1.8.0",
    "@floating-ui/react": "^0.27.20",
    "@gravity-ui/i18n": "^1.8.0",
    "@gravity-ui/icons": "^2.23.1",
    "@uiw/react-color": "^2.10.3",
    "blueimp-md5": "^2.19.0",
    "es-toolkit": "^1.53.1",
    "rc-slider": "^11.1.9",
    "react-transition-group": "^4.4.5",
    "tabbable": "^6.5.1",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.6.0",
    "@gravity-ui/eslint-config": "^4.3.2",
    "@gravity-ui/gulp-utils": "^1.2.0",
    "@gravity-ui/playwright-tools": "^2.0.2",
    "@gravity-ui/prettier-config": "^1.1.1",
    "@gravity-ui/readme-validator": "^1.3.0",
    "@gravity-ui/stylelint-config": "^5.0.0",
    "@gravity-ui/tsconfig": "^1.0.0",
    "@gravity-ui/uikit-themer": "^2.1.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "^10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/blueimp-md5": "^2.18.2",
    "@types/chroma-js": "^3.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-playwright": "^2.2.2",
    "babel-jest": "^30.5.2",
    "chroma-js": "^3.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-transform-css": "^6.0.3",
    "lz-string": "^1.5.0",
    "nano-staged": "^1.0.2",
    "npm-run-all": "^4.1.5",
    "playwright": "1.62.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "rimraf": "^6.1.3",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "storybook": "^10.6.5",
    "stylelint": "^16.26.1",
    "stylelint-use-logical": "^2.1.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@hello-pangea/dnd": "^18",
    "@tanstack/react-virtual": "^3",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-virtualized-auto-sizer": "^1",
    "react-window": "^1"
  },
  "peerDependenciesMeta": {
    "@hello-pangea/dnd": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "react-virtualized-auto-sizer": {
      "optional": true
    },
    "react-window": {
      "optional": true
    }
  },
  "overrides": {
    "ignore": "^7.0.8"
  },
  "nano-staged": {
    "*.{scss}": [
      "stylelint --fix --quiet"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.20": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "es5-ext": false,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
